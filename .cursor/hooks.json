{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node \".cursor/hooks/stale-graph-notice.js\""
      }
    ],
    "afterShellExecution": [
      {
        "command": "node \".cursor/hooks/stale-graph-notice.js\""
      }
    ],
    "sessionStart": [
      {
        "command": "node \".cursor/hooks/session-mcp-hint.js\""
      }
    ],
    "preToolUse": [
      {
        "command": "node \".cursor/hooks/boundary-notice.js\""
      }
    ]
  }
}
