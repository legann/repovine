{
  "_description": "AWS Lambda monorepo: flat handlers in lambda-functions/src/, directory domains in lambda-shared/src/<domain>/",
  "heavyDomains": ["auth", "cluster", "lambda-functions", "lambda-shared", "monday"],
  "lightweightDomains": ["tenant-manager", "oauth-callback"],
  "rejectedAsDomain": ["index", "monday-session-rate-limit", "monday-session-rate-limit-http", "audit-log", "middleware", "session-manager", "jwt-manager"],
  "modulesInDomain": {
    "auth": [
      "src/auth/middleware.ts",
      "src/auth/session-manager.ts",
      "src/auth/jwt-manager.ts"
    ],
    "monday": [
      "src/monday/monday-session-rate-limit-http.ts",
      "src/monday/monday-session-rate-limit.ts",
      "src/monday/audit-log.ts"
    ]
  }
}
