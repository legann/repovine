{
  "name": "@repovine/plugin-sdk",
  "version": "0.1.0",
  "description": "Public contract for authoring repovine source and IaC plugins.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legann/repovine.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/legann/repovine#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source-plugin": {
      "types": "./dist/source-plugin/index.d.ts",
      "import": "./dist/source-plugin/index.js"
    },
    "./iac-plugin": {
      "types": "./dist/iac-plugin/index.d.ts",
      "import": "./dist/iac-plugin/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "zod": "4.4.3"
  },
  "dependencies": {
    "@types/node": "^22.19.19"
  }
}
