    "@repovine/plugin-iac-sam": "0.1.0",
    "@repovine/plugin-iac-terraform": "0.1.0",
    "@repovine/plugin-iac-vercel": "0.1.0",
    "@repovine/plugin-source-python": "0.1.0",
    "@repovine/plugin-source-typescript": "0.1.0"
  }
