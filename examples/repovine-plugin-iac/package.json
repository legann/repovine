{
  "name": "repovine-plugin-iac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "Example third-party repovine IaC plugin: a tiny JSON edge-stack parser.",
  "peerDependencies": {
    "@repovine/plugin-sdk": "^0.1.0"
  },
  "repovine": {
    "kind": "plugin",
    "id": "edge-stack",
    "apiVersion": 1,
    "entry": "index.js",
    "declarations": {
      "ecosystem": "edge-stack",
      "triggerTypes": [
        {
          "type": "edge-http",
          "namespace": "edge-stack",
          "provider": "edge-stack",
          "entrypointKind": "api"
        },
        {
          "type": "edge-queue",
          "namespace": "edge-stack",
          "provider": "edge-stack",
          "isStreamLike": true,
          "entrypointKind": "queue-consumer"
        }
      ]
    }
  }
}
