{
  "name": "repovine-agent-harness-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable real-provider LangGraph harness for the repovine Agent Protocol. CLI and Telegram entries use Claude or local workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:egress-smoke": "HARNESS_DOCKER_SMOKE=1 node --test test/egress-smoke.docker.test.mjs",
    "test:docker-smoke": "HARNESS_DOCKER_SMOKE=1 node --test test/egress-smoke.docker.test.mjs test/local-endpoint.test.mjs",
    "start": "node scripts/compose.mjs cli",
    "attach": "node scripts/attach-launcher.mjs",
    "dev:cli": "node scripts/langgraph-cli.mjs",
    "dev:tg-bot": "node scripts/langgraph-tg-bot.mjs",
    "dev:http": "node scripts/langgraph-http.mjs",
    "docker:cli": "node scripts/compose.mjs cli",
    "docker:http": "node scripts/compose.mjs http",
    "docker:tg-bot": "node scripts/compose.mjs tg-bot",
    "docker:down": "node scripts/compose.mjs down"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.160",
    "@langchain/core": "1.2.1",
    "@langchain/langgraph": "1.4.7"
  }
}
