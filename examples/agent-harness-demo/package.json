{
  "name": "repovine-agent-harness-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable real-provider LangGraph harness for the repovine Agent Protocol. CLI and Telegram entries use Claude or local workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "start": "docker compose --profile cli run --rm --build cli",
    "attach": "node scripts/attach-launcher.mjs",
    "dev:cli": "node scripts/langgraph-cli.mjs",
    "dev:tg-bot": "node scripts/langgraph-tg-bot.mjs",
    "dev:http": "node scripts/langgraph-http.mjs",
    "docker:cli": "docker compose --profile cli run --rm --build cli",
    "docker:http": "docker compose --profile http up -d --build http",
    "docker:tg-bot": "docker compose --profile tg-bot up -d --build tg-bot",
    "docker:down": "docker compose --profile '*' down"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.160",
    "@langchain/core": "1.2.1",
    "@langchain/langgraph": "1.4.7"
  }
}
