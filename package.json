{
  "name": "repovine",
  "version": "0.1.0",
  "description": "repovine turns your repository into a structured, queryable context framework for AI coding agents.",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "packages/plugin-sdk"
  ],
  "bin": {
    "repovine": "./dist/mcp/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "legann",
  "keywords": [
    "mcp",
    "repovine",
    "codebase-navigation",
    "repository-graph",
    "dependency-analysis",
    "code-intelligence",
    "typescript",
    "cursor-plugin"
  ],
  "scripts": {
    "clean": "rm -rf dist packages/plugin-sdk/dist",
    "build:sdk": "tsc -p packages/plugin-sdk/tsconfig.json",
    "typecheck:sdk": "tsc -p packages/plugin-sdk/tsconfig.json --noEmit",
    "build": "npm run clean && npm run build:sdk && tsc && cp src/source-plugins/python/route-ast-script.py dist/source-plugins/python/route-ast-script.py",
    "typecheck": "npm run build:sdk && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "profile": "npm run build && node --expose-gc dist/profile.js",
    "render-client-plugins": "npm run build && node scripts/render-client-plugins.mjs",
    "render-client-plugins:validate": "node scripts/validate-client-plugins.mjs",
    "render-client-plugins:check": "npm run build && node scripts/render-client-plugins.mjs --check",
    "smoke:pack-install": "npm run build && node scripts/smoke-pack-install.mjs",
    "check:embedder": "npm run build && node scripts/check-embedder.mjs",
    "audit:check": "node scripts/audit-gate.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "cli": "node dist/mcp/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@repovine/plugin-sdk": "0.1.0",
    "js-yaml": "4.3.0",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.8.1 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.19",
    "eslint": "9.29.0",
    "@huggingface/transformers": "3.8.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript-eslint": "8.58.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/legann/repovine.git"
  },
  "homepage": "https://github.com/legann/repovine#readme",
  "bugs": {
    "url": "https://github.com/legann/repovine/issues"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
